includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
        - routes
        - config
        - database

    # Nivel 5: detecta errores reales sin ser demasiado estricto con tipado
    # Subir gradualmente a 6, 7, 8 conforme se corrijan errores
    level: 5

    excludePaths:
        - vendor
        - bootstrap/cache

    # Tratar tipos de PHPDoc como no-ciertos (evita falsos positivos)
    treatPhpDocTypesAsCertain: false

    # Baseline: errores existentes que se corregirán gradualmente
    ignoreErrors:
        - identifier: method.unused
        - message: '#Call to an undefined method thiagoalessio\\TesseractOCR\\TesseractOCR::lang#'
          path: app/Http/Controllers/APIS/EmpresaApiController.php
        - message: '#should return float but returns string#'
          path: app/Models/ProveedorUser.php
        - message: '#expects int, string given#'
          path: app/Services/DocumentValidationService.php
        - message: '#expects float\|int, string given#'
          path: app/Services/IaService.php
