# ══════════════════════════════════════════════
# Salcom 2.0 — Configuración de PRODUCCIÓN
# Copia este archivo como .env en el servidor
# ══════════════════════════════════════════════

APP_NAME="Industrias Salcom"
APP_ENV=production
APP_KEY=              # Generar con: php artisan key:generate
APP_DEBUG=false
APP_URL=https://portal.salcom.com

# ── Base de datos (AWS RDS MySQL) ──
DB_CONNECTION=mysql
DB_HOST=               # Endpoint de RDS (ej: salcom.xxxxx.us-east-1.rds.amazonaws.com)
DB_PORT=3306
DB_DATABASE=salcom
DB_USERNAME=           # Usuario de RDS
DB_PASSWORD=           # Contraseña de RDS

# ── Sesiones y caché ──
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# ── API de Alan (ERP) ──
PROVEEDOR_API_URL=http://54.210.85.103:7190/api
PROVEEDOR_LOGIN_MODE=fallback
CLIENTE_API_URL=http://54.210.85.103:7190/api
CLIENTE_LOGIN_MODE=fallback

# ── Amazon Bedrock (IA) — Credenciales de Chuy ──
IA_PROVIDER=bedrock
IA_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
IA_BEDROCK_REGION=us-east-1
IA_AWS_ACCESS_KEY=     # AKIA... de Chuy
IA_AWS_SECRET_KEY=     # wJal... de Chuy
IA_TIMEOUT=60

# ── Anthropic (fallback si Bedrock falla) ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── API interna Salcom (MCP / Kiro) ──
SALCOM_API_TOKEN=      # Cambiar por un token seguro en producción

# ── Gmail SMTP ──
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=         # correo@salcom.com
MAIL_PASSWORD=         # App password de Gmail
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=     # correo@salcom.com
MAIL_FROM_NAME="Industrias Salcom"

# ── Twilio (WhatsApp) ──
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── PAC para CFDI ──
PAC_DRIVER=facturama
PAC_API_URL=https://apisandbox.facturama.mx
PAC_API_USER=
PAC_API_PASSWORD=
PAC_SANDBOX=false
PAC_TIMEOUT=30

# ── Validación RFC ante SAT ──
SAT_RFC_VALIDATION_URL=
SAT_API_KEY=

# ── reCAPTCHA ──
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ── Rate Limiting ──
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_SECONDS=60

# ── Logs ──
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error
